#!/bin/bash
#
# wukongpi-wifi —— 悟空派 H3 Zero 一键联网
#
#   sudo wukongpi-wifi                    交互式输入 SSID / 密码
#   sudo wukongpi-wifi "MyWiFi" "密码"     直接指定
#   sudo wukongpi-wifi -s                 只扫描周边 WiFi
#   sudo wukongpi-wifi -i                 查看当前连接状态
#   sudo wukongpi-wifi -d                 断开
#
# 配置会写进 /etc/wpa_supplicant/wpa_supplicant.conf，
# 并自动启用 /etc/network/interfaces 里的 wlan0 段落，之后开机自动连。
#
set -u

IFACE="${WIFI_IFACE:-wlan0}"
WPA_CONF="/etc/wpa_supplicant/wpa_supplicant.conf"
IFACES="/etc/network/interfaces"
COUNTRY="${WIFI_COUNTRY:-CN}"
DRIVER="${WIFI_DRIVER:-xradio_wlan}"

c_info() { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
c_warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*"; }
c_err()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; }

usage() {
    cat <<'USAGE'
wukongpi-wifi —— 悟空派 H3 Zero 一键联网

  sudo wukongpi-wifi                   交互式输入 SSID / 密码
  sudo wukongpi-wifi "MyWiFi" "密码"    直接指定
  sudo wukongpi-wifi -s                只扫描周边 WiFi
  sudo wukongpi-wifi -i                查看当前连接状态
  sudo wukongpi-wifi -d                断开

配置写入 /etc/wpa_supplicant/wpa_supplicant.conf，
并自动启用 /etc/network/interfaces 里的 wlan0 段落，之后开机自动连。
USAGE
    exit 0
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
fi

[ "$(id -u)" -eq 0 ] || { c_err "需要 root 权限，请用 sudo 运行"; exit 1; }

# ---------------------------------------------------------------------------
# 确保驱动加载、网卡出现
# ---------------------------------------------------------------------------
ensure_iface() {
    ip link show "$IFACE" >/dev/null 2>&1 && return 0

    c_warn "XR819 在主线没有驱动，只能用 out-of-tree 的 xradio 移植版。"
    c_warn "作者自己说它不成熟、可能把内核搞挂；实测也确实不稳（会崩掉并撤走 wlan0）。"

    # 模块已经加载、但网卡不见了 → 多半是驱动内部崩过了，重载一次试试
    if lsmod 2>/dev/null | grep -q "^${DRIVER}"; then
        c_info "$DRIVER 已加载但 $IFACE 不存在（驱动内部可能已崩），重新加载"
        modprobe -r "$DRIVER" 2>/dev/null || true
        sleep 2
    else
        c_info "$IFACE 未出现，加载 $DRIVER ..."
    fi

    modprobe "$DRIVER" 2>/dev/null || true

    local i
    for i in $(seq 1 15); do
        sleep 1
        ip link show "$IFACE" >/dev/null 2>&1 && return 0
    done

    c_err "$IFACE 仍未出现，排查方向："
    c_err "    dmesg | grep -iE 'xradio|mmc1'      # 驱动 / SDIO 枚举"
    c_err "    ls -l /lib/firmware/xr819/           # 固件是否齐全"
    c_err "    ip link                              # 网卡列表"
    return 1
}

# ---------------------------------------------------------------------------
# 子命令
# ---------------------------------------------------------------------------
do_scan() {
    ensure_iface || exit 1
    rfkill unblock wifi 2>/dev/null || true
    ip link set "$IFACE" up

    c_info "扫描周边 WiFi（约 5 秒）"
    iw dev "$IFACE" scan 2>/dev/null | awk '
        /^BSS /   { }
        /SSID:/   { ssid = substr($0, index($0, "SSID:") + 5) }
        /signal:/ { if (ssid != "") printf "  %-34s %s dBm\n", ssid, $2; ssid = "" }' \
        | sort -u
}

do_status() {
    ip -br addr show "$IFACE" 2>/dev/null || c_warn "$IFACE 不存在"
    echo
    iw dev "$IFACE" link 2>/dev/null | sed 's/^/  /' || true
}

do_disconnect() {
    c_info "断开 $IFACE"
    ifdown "$IFACE" >/dev/null 2>&1 || true
    pkill -f "wpa_supplicant.*$IFACE" 2>/dev/null || true
    dhclient -r "$IFACE" >/dev/null 2>&1 || true
    ip link set "$IFACE" down 2>/dev/null || true
}

do_connect() {
    local ssid="$1" psk="$2"

    ensure_iface || exit 1
    rfkill unblock wifi 2>/dev/null || true

    c_info "写入 $WPA_CONF"
    {
        echo "country=$COUNTRY"
        echo "ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev"
        echo "update_config=1"
        echo
        wpa_passphrase "$ssid" "$psk"
    } > "$WPA_CONF"
    chmod 600 "$WPA_CONF"

    # 启用 /etc/network/interfaces 里的 wlan0 段落（幂等，已启用时不会重复改）
    if ! grep -qE "^[[:space:]]*iface[[:space:]]+$IFACE[[:space:]]+inet" "$IFACES" 2>/dev/null; then
        c_info "在 $IFACES 中启用 $IFACE（之后开机自动连）"
        sed -i -E \
            -e "s|^#(allow-hotplug $IFACE)\$|\1|" \
            -e "s|^#(iface $IFACE inet dhcp)\$|\1|" \
            -e "s|^#([[:space:]]*wpa-conf )|\1|" \
            "$IFACES"
    fi

    c_info "连接 \"$ssid\" ..."
    ifdown "$IFACE" >/dev/null 2>&1 || true
    ifup "$IFACE" 2>&1 | sed 's/^/    /'

    local i ip
    for i in $(seq 1 20); do
        ip="$(ip -4 -br addr show "$IFACE" 2>/dev/null | awk '{print $3}')"
        if [ -n "$ip" ]; then
            c_info "已联网：$IFACE  $ip"
            if ping -c1 -W3 223.5.5.5 >/dev/null 2>&1; then
                c_info "外网可达 ✓"
            else
                c_warn "拿到 IP 但 ping 不通外网，检查路由/网关"
            fi
            return 0
        fi
        sleep 1
    done

    c_err "没拿到 IP，排查方向："
    c_err "    iw dev $IFACE link"
    c_err "    journalctl -n 30 --no-pager | grep -iE 'wpa|dhcp'"
    return 1
}

# ---------------------------------------------------------------------------
# 主流程
# ---------------------------------------------------------------------------
case "${1:-}" in
    -h|--help)       usage ;;
    -s|--scan)       do_scan ;;
    -i|--status)     do_status ;;
    -d|--disconnect) do_disconnect ;;
    "")
        printf 'WiFi 名称 (SSID): '
        read -r ssid
        printf 'WiFi 密码: '
        read -r psk
        [ -n "$ssid" ] || { c_err "SSID 不能为空"; exit 1; }
        do_connect "$ssid" "$psk"
        ;;
    *)
        [ $# -ge 2 ] || { c_err "用法: wukongpi-wifi \"SSID\" \"密码\""; exit 1; }
        do_connect "$1" "$2"
        ;;
esac
