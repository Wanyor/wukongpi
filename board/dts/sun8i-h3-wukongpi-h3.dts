// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * 悟空派 H3 Zero (WukongPi H3 Zero) —— 主线 Linux 设备树
 *
 * 硬件：Allwinner H3 (4x Cortex-A7 @ 1.2GHz)
 *       - DDR3 256MB / 512MB
 *       - MicroSD  (SDC0 / PF0-PF5)
 *       - 百兆网口 (H3 内置 MII PHY)
 *       - XR819 SDIO WiFi (SDC1 / PG0-PG5)
 *       - 13pin 扩展口：USB2.0 x2、CVBS、立体声输出、麦克风、红外接收
 *       - 26pin 排针（兼容树莓派定义）：UART1/UART2、TWI、SPI1、PWM
 *       - 2MB SPI NOR (SPI0 / PC0-PC3)
 *
 * 该板与 Xunlong Orange Pi Zero 硬件基本一致，故大部分节点沿用其定义，
 * 区别在于本板使用真正的 H3 而非 H2+，因此 compatible 使用 sun8i-h3。
 *
 * WiFi 部分（vdd_wifi 1.8V / host-wake PG10 / reset PL7）来自 XR819
 * 主线移植驱动的参考设备树，见 https://github.com/fifteenhex/xradio
 *
 * 参考：arch/arm/boot/dts/allwinner/sun8i-h2-plus-orangepi-zero.dts
 */

/dts-v1/;
#include "sun8i-h3.dtsi"
#include "sunxi-common-regulators.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "WukongPi H3 Zero";
	compatible = "wukongpi,h3-zero", "allwinner,sun8i-h3";

	aliases {
		serial0 = &uart0;
		/* ethernet0 是 H3 的 EMAC，定义在 sunxi-h3-h5.dtsi 里 */
		ethernet0 = &emac;
		/*
		 * 让 U-Boot / 内核给 XR819 分配一个稳定的 MAC：sunxi U-Boot 会
		 * 根据芯片唯一 ID 生成地址并写进这个节点。
		 */
		ethernet1 = &xr819;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		/* 电源指示灯（绿色，常亮） */
		pwr_led {
			label = "wukongpi:green:pwr";
			gpios = <&r_pio 0 10 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		/* 用户可控状态灯（红色） */
		status_led {
			label = "wukongpi:red:status";
			gpios = <&pio 0 17 GPIO_ACTIVE_HIGH>;
		};
	};

	/* XR819 的 1.8V IO 电源，由 PA20 控制 */
	vdd_wifi: vdd-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vdd-wifi";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&pio 0 20 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <70000>;
		enable-active-high;
	};

	/* CPU 核心电压，由 PL6 在 1.1V / 1.3V 之间切换，配合 OPP 调频 */
	reg_vdd_cpux: vdd-cpux-regulator {
		compatible = "regulator-gpio";
		regulator-name = "vdd-cpux";
		regulator-type = "voltage";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1300000>;
		regulator-ramp-delay = <50>; /* 4ms */

		gpios = <&r_pio 0 6 GPIO_ACTIVE_HIGH>; /* PL6 */
		enable-active-high;
		gpios-states = <1>;
		states = <1100000 0>, <1300000 1>;
	};

	/* XR819 的复位时序。
	 *
	 * ⚠️ 上电等待时间必须给足。实测 50ms / 200ms 都不够：
	 * 开机时约 1/5 概率出现
	 *   mmc1: Failed to initialize a non-removable card
	 * 而初始化「边际成功」时更糟——卡枚举了但通信不可靠，固件会收到
	 * 被破坏的数据并 assert 卡死。用 unbind/bind 手动重新枚举（时序干净）
	 * 之后，扫描 / 连接 / 上网全部正常，序号零错误。
	 * 所以这里给到 1 秒，宁可开机慢一点。
	 */
	wifi_pwrseq: pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_rst>;
		reset-gpios = <&r_pio 0 7 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <1000>;
	};
};

/*
 * 音频输入/输出引到 13pin 扩展口（7/8 脚 LINEOUT，10-12 脚 MIC），
 * 接上转接板即可使用板载 H3 codec。
 * 注意：同一排针第 9 脚的 CVBS 视频输出**没有**主线驱动，见 README「已知限制」。
 */
&codec {
	allwinner,audio-routing =
		"Line Out", "LINEOUT",
		"MIC1", "Mic",
		"Mic",  "MBIAS";
	status = "okay";
};

&cpu0 {
	cpu-supply = <&reg_vdd_cpux>;
};

/* USB1：板上 USB-A 口 */
&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

/* USB2 / USB3：13pin 扩展口上的两路 USB，需转接板引出 */
&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};

&ohci2 {
	status = "okay";
};

/* 百兆网口：H3 内置 10/100 PHY */
&emac {
	phy-handle = <&int_mii_phy>;
	phy-mode = "mii";
	allwinner,leds-active-low;
	status = "okay";
};

/* TF 卡 */
&mmc0 {
	vmmc-supply = <&reg_vcc3v3>;
	bus-width = <4>;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
	status = "okay";
};

/*
 * XR819 WiFi（SDIO）
 * vmmc 是固定的 3.3V，vqmmc 是受 PA20 控制的 1.8V IO 电压 —— 这个接法
 * 来自 XR819 驱动作者在香橙派 Zero 上实测可用的配置。
 * max-frequency 压到 16MHz 是因为 XR819 在高频下非常容易丢帧。
 */
&mmc1 {
	vmmc-supply = <&reg_vcc3v3>;
	vqmmc-supply = <&vdd_wifi>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	max-frequency = <16000000>;
	non-removable;
	status = "okay";

	xr819: wifi@1 {
		reg = <1>;
		compatible = "xradio,xr819";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_wake>;
		interrupt-parent = <&pio>;
		interrupts = <6 10 IRQ_TYPE_EDGE_RISING>; /* PG10 */
		interrupt-names = "host-wake";
	};
};

/* XR819 的两个控制脚 */
&pio {
	wifi_wake: wifi-wake {
		pins = "PG10";
		function = "gpio_in";
	};
};

&r_pio {
	wifi_rst: wifi-rst {
		pins = "PL7";
		function = "gpio_out";
	};
};

/*
 * 板载 SPI NOR（PC0-PC3）。
 *
 * ⚠️ status 必须保持 "okay"，**不要改成 "disabled"**！
 *
 * 实测：关掉 spi0 会让 mmc1（XR819 WiFi 的 SDIO）初始化失败——
 *   [0.53] mmc1: Failed to initialize a non-removable card
 * 改回 okay 立刻恢复：
 *   [0.58] mmc1: new high speed SDIO card at address 0001
 *
 * 说明这块板的 PC0-PC3 并不只是接了一颗 Flash，关掉 spi0 会改变这些引脚的
 * 状态（不再 mux 成 spi0 功能），进而波及 WiFi。所以保留 enabled 是为了
 * **引脚状态**，不是为了这颗 Flash。
 *
 * 这颗 Flash 本身实测不响应（dmesg 里 `unrecognized JEDEC id bytes:
 * 00 00 00 00 00 00`），但那条报错是无害的，mtd 设备不会创建而已。
 * 如果哪天拿到焊了 Flash 的板子，这个节点正好能直接用。
 */
&spi0 {
	status = "okay";

	flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <40000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x80000>;
				read-only;
			};

			partition@80000 {
				label = "env";
				reg = <0x080000 0x10000>;
			};

			partition@90000 {
				label = "data";
				reg = <0x090000 0x170000>;
			};
		};
	};
};

/* 调试串口，接到板载 USB 转串口芯片（Type-C 口即插即用） */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pa_pins>;
	status = "okay";
};

/* 下面两个串口引到 26pin 排针，默认关闭，需要时打开 */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
	status = "disabled";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins>;
	status = "disabled";
};

/* Type-C 口默认作为外设（USB gadget）使用 */
&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	status = "okay";
	usb0_id_det-gpios = <&pio 6 12 GPIO_ACTIVE_HIGH>; /* PG12 */
};
