diff -Naur a/arch/arm/dts/sun8i-h3-wukongpi-h3.dts b/arch/arm/dts/sun8i-h3-wukongpi-h3.dts
--- /dev/null
+++ b/arch/arm/dts/sun8i-h3-wukongpi-h3.dts	2026-10-13 17:47:34.829485992 +0000
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * 悟空派 H3 Zero (WukongPi H3 Zero) —— 主线 Linux 设备树
+ *
+ * 硬件：Allwinner H3 (4x Cortex-A7 @ 1.2GHz)
+ *       - DDR3 256MB / 512MB
+ *       - MicroSD  (SDC0 / PF0-PF5)
+ *       - 百兆网口 (H3 内置 MII PHY)
+ *       - XR819 SDIO WiFi (SDC1 / PG0-PG5)
+ *       - 13pin 扩展口 (UART2、2x USB2.0、IR、CVBS+音频)
+ *       - 2MB SPI NOR (SPI0 / PC0-PC3)
+ *
+ * 该板与 Xunlong Orange Pi Zero 硬件基本一致，故大部分节点沿用其定义，
+ * 区别在于本板使用真正的 H3 而非 H2+，因此 compatible 使用 sun8i-h3。
+ *
+ * WiFi 部分（vdd_wifi 1.8V / host-wake PG10 / reset PL7）来自 XR819
+ * 主线移植驱动的参考设备树，见 https://github.com/fifteenhex/xradio
+ *
+ * 参考：arch/arm/boot/dts/allwinner/sun8i-h2-plus-orangepi-zero.dts
+ */
+
+/dts-v1/;
+#include "sun8i-h3.dtsi"
+#include "sunxi-common-regulators.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+/ {
+	model = "WukongPi H3 Zero";
+	compatible = "wukongpi,h3-zero", "allwinner,sun8i-h3";
+
+	aliases {
+		serial0 = &uart0;
+		/* ethernet0 是 H3 的 EMAC，定义在 sunxi-h3-h5.dtsi 里 */
+		ethernet0 = &emac;
+		/*
+		 * 让 U-Boot / 内核给 XR819 分配一个稳定的 MAC：sunxi U-Boot 会
+		 * 根据芯片唯一 ID 生成地址并写进这个节点。
+		 */
+		ethernet1 = &xr819;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		/* 电源指示灯（绿色，常亮） */
+		pwr_led {
+			label = "wukongpi:green:pwr";
+			gpios = <&r_pio 0 10 GPIO_ACTIVE_HIGH>;
+			default-state = "on";
+		};
+
+		/* 用户可控状态灯（红色） */
+		status_led {
+			label = "wukongpi:red:status";
+			gpios = <&pio 0 17 GPIO_ACTIVE_HIGH>;
+		};
+	};
+
+	/* XR819 的 1.8V IO 电源，由 PA20 控制 */
+	vdd_wifi: vdd-wifi {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd-wifi";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&pio 0 20 GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <70000>;
+		enable-active-high;
+	};
+
+	/* CPU 核心电压，由 PL6 在 1.1V / 1.3V 之间切换，配合 OPP 调频 */
+	reg_vdd_cpux: vdd-cpux-regulator {
+		compatible = "regulator-gpio";
+		regulator-name = "vdd-cpux";
+		regulator-type = "voltage";
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1300000>;
+		regulator-ramp-delay = <50>; /* 4ms */
+
+		gpios = <&r_pio 0 6 GPIO_ACTIVE_HIGH>; /* PL6 */
+		enable-active-high;
+		gpios-states = <1>;
+		states = <1100000 0>, <1300000 1>;
+	};
+
+	/* XR819 的复位时序 */
+	wifi_pwrseq: pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_rst>;
+		reset-gpios = <&r_pio 0 7 GPIO_ACTIVE_LOW>;
+		post-power-on-delay-ms = <50>;
+	};
+};
+
+/*
+ * 音频输入/输出引到 13pin 扩展口，接上转接板即可使用板载 H3 codec。
+ * 注意：H3 的 CVBS 电视编码器（TVE）**没有**主线驱动，见 README「已知限制」。
+ */
+&codec {
+	allwinner,audio-routing =
+		"Line Out", "LINEOUT",
+		"MIC1", "Mic",
+		"Mic",  "MBIAS";
+	status = "okay";
+};
+
+&cpu0 {
+	cpu-supply = <&reg_vdd_cpux>;
+};
+
+/* USB1：板上 USB-A 口 */
+&ehci0 {
+	status = "okay";
+};
+
+&ohci0 {
+	status = "okay";
+};
+
+/* USB2 / USB3：13pin 扩展口上的两路 USB，需转接板引出 */
+&ehci1 {
+	status = "okay";
+};
+
+&ohci1 {
+	status = "okay";
+};
+
+&ehci2 {
+	status = "okay";
+};
+
+&ohci2 {
+	status = "okay";
+};
+
+/* 百兆网口：H3 内置 10/100 PHY */
+&emac {
+	phy-handle = <&int_mii_phy>;
+	phy-mode = "mii";
+	allwinner,leds-active-low;
+	status = "okay";
+};
+
+/* TF 卡 */
+&mmc0 {
+	vmmc-supply = <&reg_vcc3v3>;
+	bus-width = <4>;
+	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
+	status = "okay";
+};
+
+/*
+ * XR819 WiFi（SDIO）
+ * vmmc 是固定的 3.3V，vqmmc 是受 PA20 控制的 1.8V IO 电压 —— 这个接法
+ * 来自 XR819 驱动作者在香橙派 Zero 上实测可用的配置。
+ * max-frequency 压到 16MHz 是因为 XR819 在高频下非常容易丢帧。
+ */
+&mmc1 {
+	vmmc-supply = <&reg_vcc3v3>;
+	vqmmc-supply = <&vdd_wifi>;
+	mmc-pwrseq = <&wifi_pwrseq>;
+	bus-width = <4>;
+	max-frequency = <16000000>;
+	non-removable;
+	status = "okay";
+
+	xr819: wifi@1 {
+		reg = <1>;
+		compatible = "xradio,xr819";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_wake>;
+		interrupt-parent = <&pio>;
+		interrupts = <6 10 IRQ_TYPE_EDGE_RISING>; /* PG10 */
+		interrupt-names = "host-wake";
+	};
+};
+
+/* XR819 的两个控制脚 */
+&pio {
+	wifi_wake: wifi-wake {
+		pins = "PG10";
+		function = "gpio_in";
+	};
+};
+
+&r_pio {
+	wifi_rst: wifi-rst {
+		pins = "PL7";
+		function = "gpio_out";
+	};
+};
+
+/* 板载 2MB SPI NOR，可用于存放 U-Boot / 环境变量 / 小文件系统 */
+&spi0 {
+	status = "okay";
+
+	flash@0 {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <40000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x000000 0x80000>;
+				read-only;
+			};
+
+			partition@80000 {
+				label = "env";
+				reg = <0x080000 0x10000>;
+			};
+
+			partition@90000 {
+				label = "data";
+				reg = <0x090000 0x170000>;
+			};
+		};
+	};
+};
+
+/* 调试串口，接到板载 USB 转串口芯片（Type-C 口即插即用） */
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pa_pins>;
+	status = "okay";
+};
+
+/* 下面两个串口引到 13pin 扩展口，默认关闭，需要时打开 */
+&uart1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart1_pins>;
+	status = "disabled";
+};
+
+&uart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart2_pins>;
+	status = "disabled";
+};
+
+/* Type-C 口默认作为外设（USB gadget）使用 */
+&usb_otg {
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&usbphy {
+	status = "okay";
+	usb0_id_det-gpios = <&pio 6 12 GPIO_ACTIVE_HIGH>; /* PG12 */
+};
diff -Naur a/configs/wukongpi_h3_defconfig b/configs/wukongpi_h3_defconfig
--- /dev/null
+++ b/configs/wukongpi_h3_defconfig	2026-10-13 17:47:34.147485933 +0000
@@ -0,0 +1,64 @@
+# ============================================================================
+#  悟空派 H3 Zero — U-Boot 板级配置
+#
+#  基线：configs/orangepi_zero_defconfig (v2026.07)
+#  构建：make wukongpi_h3_defconfig
+# ============================================================================
+
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_DEFAULT_DEVICE_TREE="sun8i-h3-wukongpi-h3"
+
+# DDR3 运行在 624MHz (DDR3-1248)。真正的容量 (256/512MB) 由 SPL
+# 在运行时通过 mctl_auto_detect_dram_size() 自动探测，无需区分版本。
+CONFIG_DRAM_CLK=624
+
+CONFIG_SPL=y
+CONFIG_MACH_SUN8I_H3=y
+
+# 板子没有 HDMI，不需要显示引擎
+# CONFIG_VIDEO_DE2 is not set
+
+# 板载 2MB SPI NOR：允许 U-Boot 自身放进 SPI Flash 启动
+CONFIG_SPL_SPI_SUNXI=y
+
+# SPL 阶段点亮绿色电源灯 (PL10)，启动失败时方便肉眼判断
+CONFIG_SPL_SUNXI_LED_STATUS=y
+CONFIG_SPL_SUNXI_LED_STATUS_GPIO=362
+
+# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
+CONFIG_CONSOLE_MUX=y
+
+# ---- 启动流程：distro boot，自动扫描 SD 卡上的 extlinux.conf ----
+CONFIG_BOOTDELAY=1
+CONFIG_USE_BOOTCOMMAND=y
+CONFIG_BOOTCOMMAND="run distro_bootcmd"
+
+# 内核镜像上限。默认只有 8MB，加了容器支持后 zImage 可能逼近这个值，
+# 提到 64MB 避免 "Image too large" 之类的问题。
+CONFIG_SYS_BOOTM_LEN=0x4000000
+
+# ---- 外设 ----
+CONFIG_SUN8I_EMAC=y
+CONFIG_SPI=y
+CONFIG_MTD=y
+CONFIG_USB_EHCI_HCD=y
+CONFIG_USB_OHCI_HCD=y
+CONFIG_USB_STORAGE=y
+CONFIG_CMD_USB=y
+
+# ---- SPI NOR 器件支持 (尽量覆盖常见 2MB 型号) ----
+CONFIG_SPI_FLASH_MACRONIX=y
+CONFIG_SPI_FLASH_WINBOND=y
+CONFIG_SPI_FLASH_GIGADEVICE=y
+CONFIG_SPI_FLASH_ISSI=y
+CONFIG_SPI_FLASH_SST=y
+CONFIG_SPI_FLASH_SPANSION=y
+CONFIG_SPI_FLASH_STMICRO=y
+CONFIG_SPI_FLASH_XMC=y
+CONFIG_CMD_SF=y
+
+# ---- 调试用命令 ----
+CONFIG_CMD_GPIO=y
+CONFIG_CMD_I2C=y
+CONFIG_CMD_PART=y
