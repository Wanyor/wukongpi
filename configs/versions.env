# ============================================================================
#  悟空派 H3 Zero — 版本与路径锁定
#  所有脚本都会 source 这个文件, 改动这里即可切换版本。
# ============================================================================

# ---- 目标板 ----
export BOARD_NAME="wukongpi-h3"
export BOARD_DTS="sun8i-h3-wukongpi-h3"

# ---- 上游源码版本 ----
# Linux 6.18.x 是当前 LTS (kernel.org longterm)
export LINUX_VERSION="${LINUX_VERSION:-v6.18.56}"
export LINUX_REPO="${LINUX_REPO:-https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git}"

# U-Boot 最新稳定发布版
export UBOOT_VERSION="${UBOOT_VERSION:-v2026.07}"
export UBOOT_REPO="${UBOOT_REPO:-https://github.com/u-boot/u-boot.git}"

# 板载 XR819 WiFi (主线无驱动, 使用 out-of-tree 移植仓库)
#
# 用 clankerfixedmywifi-260903 而不是 master：这个分支加了固件崩溃后的
# 自动恢复（warm reboot），而 master 在缓冲区溢出时是 BUG_ON 直接 panic。
# 提交记录里作者就是在 Orange Pi Zero + Linux 6.18-sunxi 上测的。
export XRADIO_REPO="${XRADIO_REPO:-https://github.com/fifteenhex/xradio.git}"
export XRADIO_VERSION="${XRADIO_VERSION:-clankerfixedmywifi-260903}"

# ---- 根文件系统 ----
export ROOTFS_DISTRO="${ROOTFS_DISTRO:-debian}"
export ROOTFS_RELEASE="${ROOTFS_RELEASE:-bookworm}"
export ROOTFS_BASE_TAG="${ROOTFS_BASE_TAG:-wukongpi-base:${ROOTFS_RELEASE}}"
export ROOTFS_MIRROR="${ROOTFS_MIRROR:-http://deb.debian.org/debian}"
export ROOTFS_HOSTNAME="${ROOTFS_HOSTNAME:-wukongpi}"
export ROOTFS_USER="${ROOTFS_USER:-orangepi}"
export ROOTFS_PASSWORD="${ROOTFS_PASSWORD:-orangepi}"
export ROOTFS_ROOT_PASSWORD="${ROOTFS_ROOT_PASSWORD:-root}"
export ROOTFS_TIMEZONE="${ROOTFS_TIMEZONE:-Asia/Shanghai}"

# ---- 镜像布局 ----
export IMAGE_SIZE_MB="${IMAGE_SIZE_MB:-2048}"      # SD 镜像总大小
export BOOT_SIZE_MB="${BOOT_SIZE_MB:-64}"          # FAT32 启动分区
export UBOOT_SPL_SEEK_KB="${UBOOT_SPL_SEEK_KB:-8}" # u-boot-sunxi-with-spl.bin 写入偏移

# ---- Docker ----
export BUILD_IMAGE="${BUILD_IMAGE:-wukongpi-build:latest}"
export BUILD_VOLUME="${BUILD_VOLUME:-wukongpi-build}"

# ---- 容器内路径 (不要改) ----
export PROJECT_DIR="/project"
export BUILD_DIR="/build"
export SOURCES_DIR="/build/sources"
export OUT_DIR="/build/out"
export LINUX_SRC="/build/sources/linux"
export UBOOT_SRC="/build/sources/u-boot"
export XRADIO_SRC="/build/sources/xradio"
export ROOTFS_DIR="/build/rootfs"
export CROSS_COMPILE="arm-linux-gnueabihf-"
export ARCH="arm"
