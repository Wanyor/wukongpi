# ============================================================================
#  悟空派 H3 Zero — Linux 内核配置片段
#
#  基线：arch/arm/configs/sunxi_defconfig
#  合并：scripts/kconfig/merge_config.sh -m .config wukongpi.fragment
# ============================================================================

# ---------------------------------------------------------------------------
#  WiFi: XR819 主线无驱动，需要 out-of-tree 的 xradio 模块
#        xradio 依赖 cfg80211 / mac80211
# ---------------------------------------------------------------------------
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_CFG80211_WEXT=y
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PROC=y
CONFIG_WEXT_SPY=y
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y

# ---------------------------------------------------------------------------
#  USB gadget (Type-C OTG) —— 可做 RNDIS/ACM 网卡与串口
# ---------------------------------------------------------------------------
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_ACC=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_ETH=m
CONFIG_USB_ETH_RNDIS=y
CONFIG_USB_MASS_STORAGE=m

# ---------------------------------------------------------------------------
#  容器支撑 (Docker / containerd) —— 512MB 内存跑容器建议配 zram
# ---------------------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VETH=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_OVERLAY_FS=m
# zram 直接编进内核，避免 systemd-zram-generator 找不到模块
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
# 已经用 zram 当 swap 了，不需要 zswap 再压一层
CONFIG_ZSWAP=y
CONFIG_CRYPTO_LZ4=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y

# ---------------------------------------------------------------------------
#  文件系统
# ---------------------------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_MSDOS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ---------------------------------------------------------------------------
#  网络：常用驱动与队列调度
# ---------------------------------------------------------------------------
CONFIG_NET_SCH_FQ_CODEL=y

# ---------------------------------------------------------------------------
#  硬件相关
# ---------------------------------------------------------------------------
# 板载 2MB SPI NOR (SPI0)
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI_SUN6I=y
# PWM（风扇 / 红外 / 蜂鸣器）
CONFIG_PWM=y
CONFIG_PWM_SUN4I=y
# 红外遥控
CONFIG_RC_CORE=y
CONFIG_MEDIA_RC_SUPPORT=y
CONFIG_IR_SUNXI=y
# 硬件随机数 / 加密
CONFIG_CRYPTO_DEV_SUN8I_CE=y

# ---------------------------------------------------------------------------
#  杂项
# ---------------------------------------------------------------------------
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_BPF_SYSCALL=y
CONFIG_USERFAULTFD=y
CONFIG_POSIX_TIMERS=y
